<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>terrain</AssemblyName>
    <RootNamespace>Tns.Tools.Terrain</RootNamespace>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Smooth text on the maps the tool draws, from the system's own fonts. Windows only; elsewhere
         the maps fall back to a built-in pixel font. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tile format is shared with the game, so both always agree on it. -->
    <Compile Include="..\..\..\src\Core\Terrain\**\*.cs" LinkBase="Core\Terrain" />
  </ItemGroup>
</Project>
